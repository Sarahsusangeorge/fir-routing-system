# Copy to backend/.env and fill in. backend/.env is git-ignored.

# development (default) or production. In production the server refuses to
# start with a missing or short JWT secret, cookies without Secure, the
# debugger on, demo accounts still using their published passwords, or no
# real channel for sign-in codes; and codes are never printed to the console.
NIVARA_ENV=development

# Signs session tokens. Leave unset in development and one is generated into
# backend/.jwt_secret (mode 600). In any shared or deployed setup, set a long
# random value: python -c "import secrets; print(secrets.token_urlsafe(48))"
NIVARA_JWT_SECRET=

# Frontend origin(s) allowed to call the API with cookies, comma-separated.
# Use the same hostname as the API (localhost with localhost).
NIVARA_FRONTEND_ORIGINS=http://localhost:5173

# Set to 1 when the site is served over HTTPS (also enables HSTS).
NIVARA_COOKIE_SECURE=0

# API port. macOS uses 5000 for AirPlay Receiver; 5001 avoids the clash.
NIVARA_PORT=5000

# Werkzeug debugger. It allows running arbitrary code from the browser:
# leave 0 except on your own machine, and never in production.
FIR_DEBUG=0

# Optional: database file location (defaults to backend/fir_system.db).
# NIVARA_DB_PATH=

# Email for citizen sign-in codes. Without SMTP_HOST (and without an SMS
# provider) codes are printed to the backend console in development only.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS for citizen sign-in codes: console (development) or twilio.
# Commercial SMS to Indian numbers needs a TRAI DLT-registered sender.
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
