# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Signs session tokens. Leave unset in development and one is generated into
# backend/.jwt_secret. In any shared or deployed setup, set a long random
# value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
NIVARA_JWT_SECRET=

# Frontend origin(s) allowed to call the API with cookies, comma-separated.
# Use the same hostname as the API (localhost with localhost).
NIVARA_FRONTEND_ORIGINS=http://localhost:5173

# Set to 1 when the site is served over HTTPS.
NIVARA_COOKIE_SECURE=0

# Flask debugger (1 = on). Turn it off anywhere other than your own machine.
FLASK_DEBUG=1

# Email for citizen sign-in codes. Without SMTP_HOST, codes are printed to
# the backend console instead of being emailed.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an App Password
# (Google Account > Security > App passwords), not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
