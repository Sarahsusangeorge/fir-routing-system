# Base URL of the NIVARA classification API. When unset, the frontend
# runs in demo mode using a local rule-based classifier and seeded
# complaint history so the product remains fully demonstrable offline.
VITE_API_BASE_URL=
#
# With a backend: VITE_API_BASE_URL=http://localhost:5000
# Open the app at http://localhost:5173 so the host matches the API's.
# Demo mode replaces sign-in with a role picker.
